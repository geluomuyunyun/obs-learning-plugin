uniform float4x4 ViewProj;   // OBS 传进来的投影矩阵,固定写法
uniform texture2d image;     // OBS 传进来的原始画面

sampler_state def_sampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// 顶点着色器:把顶点变换到屏幕空间。所有滤镜都长这样,照抄即可
VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

// 像素着色器:每个像素调一次,这里才是"反相"发生的地方
float4 PSInvert(VertData v_in) : TARGET
{
    float4 color = image.Sample(def_sampler, v_in.uv);
    return float4(1.0 - color.rgb, color.a);   // alpha 保持不变,不然会透明
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSInvert(v_in);
    }
}